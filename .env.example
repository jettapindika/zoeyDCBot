# --- Discord ---
# Bot token from https://discord.com/developers/applications
# Enable the Message Content Intent in the Bot settings!
DISCORD_BOT_TOKEN=

# Optional: register slash commands to one guild for fast iteration.
# Leave empty for global commands (can take up to 1 hour to propagate).
COMMAND_GUILD_ID=

# --- LLM (OpenAI-compatible) ---
# OpenAI:    https://api.openai.com/v1
# DeepSeek:  https://api.deepseek.com/v1
# vLLM local: http://localhost:8000/v1
# Ollama:    http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=opencodeft/deepseek-v4-flash-free

# --- AI Behaviour ---
SYSTEM_PROMPT=You are a helpful Discord assistant. Answer concisely and naturally, using markdown when it helps.
# Comma-separated channel IDs; empty = respond in every channel.
ALLOWED_CHANNEL_IDS=
# Rolling conversation turns kept per channel.
CONTEXT_TURNS=20
# Minutes before inactive channel history is evicted.
HISTORY_TTL_MINUTES=30
# Concurrent LLM generations.
MAX_WORKERS=4
# Pending LLM requests in the queue.
QUEUE_SIZE=128
# Min ms between streaming message edits (Discord edit rate limit ~1/sec).
EDIT_INTERVAL_MS=1000
# LLM request timeout in seconds.
LLM_TIMEOUT_SECONDS=120
# LLM retry count for transient (5xx/network) errors.
LLM_MAX_RETRIES=1

# --- Admin / Moderation ---
# Comma-separated role IDs allowed to use admin commands (in addition to Discord perms).
ADMIN_ROLE_IDS=
# Optional channel ID for moderation audit log messages.
MOD_LOG_CHANNEL_ID=

# --- Welcome / Goodbye ---
# Enable welcome messages when members join.
WELCOME_ENABLED=false
# Channel ID for welcome/goodbye messages.
WELCOME_CHANNEL_ID=
# Custom welcome message. Placeholders: {user}, {mention}, {server}.
# Default: "Welcome to the server, {user}! 🎉"
WELCOME_MESSAGE=
# Enable goodbye messages when members leave.
GOODBYE_ENABLED=false
# Custom goodbye message. Placeholders: {user}, {mention}, {server}.
# Default: "Goodbye, {user}! We'll miss you. 👋"
GOODBYE_MESSAGE=

# --- Music ---
# Enable music slash commands.
MUSIC_ENABLED=true
# Path to yt-dlp binary (default: yt-dlp, auto-detected from PATH).
YTDLP_PATH=yt-dlp
# Path to ffmpeg binary (default: ffmpeg, auto-detected from PATH).
FFMPEG_PATH=ffmpeg
# Maximum queued tracks per guild.
MUSIC_MAX_QUEUE=50

# --- Logging ---
# Log level: debug, info, warn, error (default: info).
# Use debug to see yt-dlp/ffmpeg commands, opus frame progress, etc.
LOG_LEVEL=info
